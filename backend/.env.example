# Copy to backend/.env for local development. Never commit backend/.env.

# Which settings module to load: config.settings.development | config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Comma separated. Required in production, e.g. api.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL, the only supported database. Required in production; development
# and tests default to this local database when it is unset.
DATABASE_URL=postgres://roambeyond:roambeyond@localhost:5432/roambeyond

# Shared cache for rate limiting. Falls back to in-process memory in development when unset.
CACHE_URL=redis://localhost:6379/1

# Browser origins allowed to call the API (the Next.js site), comma separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Set to true when running behind a reverse proxy or load balancer that sets
# X-Forwarded-For and X-Forwarded-Proto (nginx, Caddy, a PaaS router).
TRUST_PROXY_HEADERS=false

# Email. Development logs emails to the console unless RESEND_API_KEY is set.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=enquiries@example.com
ENQUIRY_FROM_EMAIL="Website enquiries <onboarding@resend.dev>"

# Uploaded photos. Without MEDIA_BUCKET they are saved under MEDIA_ROOT and
# served by Django at /media/. In production use a bucket: container disks
# are wiped on deploy. Any S3-compatible service works (S3, Cloudflare R2, ...).
MEDIA_ROOT=
MEDIA_BUCKET=
MEDIA_ENDPOINT_URL=
MEDIA_REGION=
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
# Public domain the bucket is served from, e.g. media.example.com
MEDIA_CUSTOM_DOMAIN=
# Base for absolute photo URLs when files are on local disk, e.g. https://api.example.com
PUBLIC_MEDIA_BASE_URL=

# After an admin edit the backend asks the website to refresh its cache.
# The secret must equal REVALIDATE_SECRET in the website's environment.
# Development defaults: http://localhost:3000/api/revalidate and dev-revalidate-secret.
FRONTEND_REVALIDATE_URL=
FRONTEND_REVALIDATE_SECRET=

# Staff dashboard sign-in (JWT). The signing key defaults to DJANGO_SECRET_KEY;
# set a separate 32+ character key to be able to sign everyone out by rotating it.
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Failed sign-ins before an account locks, and for how long; per-IP attempt limit.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_THROTTLE_RATE=10/15m

# Enquiry emails: send visitors a copy of their enquiry; link agency emails to the admin.
ENQUIRY_ACKNOWLEDGE_VISITORS=true
ADMIN_PANEL_URL=https://www.example.com/admin
FRONTEND_URL=

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Security and deployment (production)
# Origins the browser may call the API from, e.g. the website's domain. Required in production.
CORS_ALLOWED_ORIGINS=https://www.example.com
# Origins allowed to post forms with cookies. Defaults to CORS_ALLOWED_ORIGINS.
CSRF_TRUSTED_ORIGINS=
# HSTS: seconds browsers keep to HTTPS only. Raise it once the site is proven on HTTPS.
SECURE_HSTS_SECONDS=3600
# Seconds to keep a database connection open between requests.
DB_CONN_MAX_AGE=60
# Enquiry submissions per IP (Django REST throttle rate).
ENQUIRY_THROTTLE_RATE=5/10m
# Seconds to wait for the website refresh call before giving up.
FRONTEND_REVALIDATE_TIMEOUT=3
# Serve uploaded photos from this server. Defaults to on unless MEDIA_BUCKET is set.
SERVE_MEDIA=

# Production requirements: a shared cache (Redis) so lockouts and rate limits are shared
# by every worker, and an explicit proxy choice for client IP addresses.
CACHE_URL=redis://localhost:6379/1
# true behind a load balancer you control (it must overwrite X-Forwarded-For); false otherwise.
TRUST_PROXY_HEADERS=false
# Proxies in front of the API (used with TRUST_PROXY_HEADERS). Render needs 2.
TRUSTED_PROXY_COUNT=2
