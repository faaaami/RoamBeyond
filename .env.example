# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git.

# Public URL of the Django API (backend/). Inlined into the browser bundle at
# build time, so set it before `next build`. Defaults to http://localhost:8000
# in development. Enquiry email settings live in backend/.env.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: the address the Next.js server uses to reach the API, if it differs
# from the public one (e.g. http://api:8000 inside Docker or a private network).
API_URL=

# Optional: public origin of the photo bucket, when the backend stores uploads in
# S3-compatible storage with a custom domain, e.g. https://media.example.com
MEDIA_HOST_URL=

# Shared secret the backend sends to /api/revalidate after an admin edit.
# Must equal FRONTEND_REVALIDATE_SECRET in backend/.env. Required in production;
# development defaults to "dev-revalidate-secret" on both sides.
REVALIDATE_SECRET=

# Public URL of the site, no trailing slash. Used for SEO tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.example.com
